{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "cf-tams-auth",
  "main": "worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "d1_databases": [{ "binding": "DB", "database_name": "cf-tams-auth", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "TOKEN_RATE_LIMIT", "namespace_id": "7101", "simple": { "limit": 60, "period": 60 } }],
  "vars": {
    "AUTH_ISSUER": "http://127.0.0.1:8788",
    "TAMS_AUDIENCE": "http://127.0.0.1:8787",
    "CORS_ORIGINS": "[\"http://localhost:3000\"]"
  }
}
